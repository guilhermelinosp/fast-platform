# Copy to .env and adjust. SOCKET_URL is only read by the test client (go run . client).
HELLNET_SERVICE=fast-sockets
HELLNET_PORT=8082
HELLNET_ENVIRONMENT=Development
HELLNET_TELEMETRY_ENDPOINT=http://localhost:4318
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC_ORDER_REQUESTED=br.com.hellnet.fast.order.requested.v1
KAFKA_TOPIC_ORDER_ACCEPTED=br.com.hellnet.fast.order.accepted.v1
SOCKET_DRIVERS_NAMESPACE=/drivers
SOCKET_RIDERS_NAMESPACE=/riders
SOCKET_URL=ws://localhost:8082
