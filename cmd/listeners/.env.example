# Copy to .env and adjust.
HELLNET_SERVICE=fast-listeners
HELLNET_ENVIRONMENT=Development
HELLNET_TELEMETRY_ENDPOINT=http://localhost:4318
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=plaintext
KAFKA_TOPIC_ORDER_REQUESTED=br.com.hellnet.fast.order.requested.v1
KAFKA_TOPIC_ORDER_ACCEPTED=br.com.hellnet.fast.order.accepted.v1
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fast
DATABASE_USERNAME=fast
DATABASE_PASSWORD=change-me
DATABASE_POOL_MAX_SIZE=10
KAFKA_MATCHING_CONSUMER_GROUP=fast-matching
HELLNET_CACHE_CONNECTION=localhost:6379
HELLNET_CACHE_ENABLE_L2=true
HELLNET_CACHE_DEFAULT_TTL=5m
